{
  "version": 2,
  "framework": "vite",
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/tour-pricing",
      "destination": "/day-trips/",
      "permanent": true
    },
    {
      "source": "/tour-pricing/",
      "destination": "/day-trips/",
      "permanent": true
    },
    {
      "source": "/private-day-trips",
      "destination": "/day-trips/",
      "permanent": true
    },
    {
      "source": "/private-day-trips/",
      "destination": "/day-trips/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
